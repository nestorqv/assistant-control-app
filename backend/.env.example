# Copy to backend/.env (gitignored). Plain KEY=value, no quotes, no 'export'.
DB_URL=jdbc:postgresql://localhost:5432/asistencia
DB_USER=asistencia_app
DB_PASSWORD=change-me

# JWT signing key: base64, at least 32 random bytes (48 recommended). Generate with
# PowerShell: $b=New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Git Bash:   openssl rand -base64 48
JWT_SECRET=
# Dev profile only: shared PIN for all seeded demo users. Exactly 8 digits; must not be
# all one digit, a sequence (12345678, 87654321), a repeated block (12121212, 12341234)
# or a date (DDMMYYYY, MMDDYYYY, YYYYMMDD). Startup fails with a clear message otherwise.
DEV_SEED_PIN=

# Photo storage directory (default: uploads, relative to backend/). Must not be inside src/ or a static folder.
UPLOADS_DIR=
# Dev profile only, optional: put the seeded branch at your real location to test the geofence.
# Decimal degrees with a dot (9.9325, -84.0796); radius 10..5000 m. Applied on every dev start when set.
DEV_SEED_LAT=
DEV_SEED_LNG=
DEV_SEED_RADIUS=
